    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "jsdom": "^27.4.0",
    "msw": "^2.x",
    "typescript": "^5.x",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12",
