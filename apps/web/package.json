    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@mui/x-charts": "^9.18.1",
    "@mui/x-data-grid": "^9.18.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.10.x",
    "@xterm/addon-search": "^0.15.x",
    "@xterm/addon-web-links": "^0.11.x",
    "@xterm/xterm": "^5.x",
