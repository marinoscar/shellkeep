{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "description": "The shellkeep command-line client: @marinoscar/platform-cli composed with ShellKeep's identity, deploy checks and terminal commands.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shellkeep": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:ci": "vitest run --coverage --passWithNoTests --reporter=junit --outputFile=junit.xml"
  },
  "dependencies": {
    "@marinoscar/platform-cli": "0.1.0-next.39",
    "@marinoscar/platform-infra": "0.1.0-next.39",
    "@shellkeep/shared": "*",
    "commander": "^14.0.2",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
