// ShellKeep domain: runbooks, reusable and versioned multi-step procedures (#61).
//
// Ownership: org-owned (`orgId`); `ownerUserId` is the author and goes NULL when that user is deleted.
// Both tables are `org` tables: forced row-level security, one `<table>_org_isolation` policy each
//   (see the migration and `rlsPolicies` in prisma/platform.lock).
// A version row reaches its runbook through the COMPOSITE key (runbook_id, org_id) -> runbooks (id, org_id),
//   with the supporting `@@unique([id, orgId])`: a foreign-key check bypasses RLS, so a plain key would let
//   one organization point at another's runbook.
// Raw-SQL index (intentional schema drift, never an `@@unique`): `runbooks_org_name_live_uniq_idx`, a unique
//   `(org_id, lower(name)) WHERE archived_at IS NULL`. Listed in `rawSqlIndexes` in prisma/platform.lock.
// Sharing (#71): `ownerGroupId` is the OPTIONAL owning group, a COMPOSITE foreign key (org_id, owner_group_id)
//   -> groups (id, org_id) so a group of another organization cannot own a runbook. NULL skips the check
//   (MATCH SIMPLE). `ownerUserId` stays the author; a runbook with no `ownerGroupId` is owned by that user,
//   and one whose author was deleted is owned by nobody (only the org-wide permissions reach it).
// `runbook_versions` is IMMUTABLE: no code path updates or deletes a row, except the cascade on runbook purge.
// `latestVersionId` is a plain column (no foreign key: the two tables point at each other).

model Runbook {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  ownerGroupId    String?   @map("owner_group_id") @db.Uuid
  name            String    @db.VarChar(120)
  description     String?   @db.Text
  tags            String[]
  latestVersionId String?   @map("latest_version_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?           @relation("RunbookOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerGroup   Group?          @relation("RunbookOwnerGroup", fields: [ownerGroupId, orgId], references: [id, orgId], onDelete: NoAction)
  versions     RunbookVersion[]
  runs         RunbookRun[]

  @@unique([id, orgId])
  @@index([orgId])
  @@index([ownerUserId])
  @@index([orgId, ownerGroupId])
  @@map("runbooks")
}

model RunbookVersion {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  runbookId        String   @map("runbook_id") @db.Uuid
  version          Int
  definition       Json     @db.JsonB
  definitionSha256 String   @map("definition_sha256") @db.Char(64)
  changelog        String?  @db.VarChar(500)
  createdBy        String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runbook      Runbook      @relation(fields: [runbookId, orgId], references: [id, orgId], onDelete: Cascade)
  author       User?        @relation("RunbookVersionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  runs         RunbookRun[]

  @@unique([runbookId, version])
  @@index([orgId])
  @@index([createdBy])
  @@map("runbook_versions")
}

extend model User {
  ownedRunbooks     Runbook[]        @relation("RunbookOwner")
  runbookVersions   RunbookVersion[] @relation("RunbookVersionAuthor")
}

extend model Organization {
  runbooks        Runbook[]
  runbookVersions RunbookVersion[]
}

// =============================================================================
// Runbook runs (issue #62): the execution engine's tables.
// =============================================================================
//
// All six are `org` tables: a NOT NULL `org_id`, forced row-level security (one
// `<table>_org_isolation` policy each, listed under `rlsPolicies` in prisma/platform.lock) and
// COMPOSITE foreign keys that include `org_id` between org tables (a foreign-key check bypasses RLS).
// Every status column is `text` with a CHECK constraint (migration SQL; Prisma cannot express one):
//   runbook_runs.status          queued resolving running paused cancelling succeeded failed partially_failed aborted cancelled
//   runbook_runs.trigger         manual api schedule
//   runbook_run_targets.status   pending queued running waiting succeeded failed skipped cancelled
//   runbook_run_steps.status     pending running waiting_approval succeeded failed skipped timed_out cancelled
//   runbook_command_executions.origin   step ai_agent dry_run   (`dry_run`: a read-only probe of a dry run, #67)
//   runbook_approvals.status     pending approved rejected expired
//   runbook_approvals.kind       step gate destructive_run   (`gate`: the canary pause after the first wave;
//                                `destructive_run`: the two-person approval of a destructive run, #67)
//   runbook_approvals.scope      run target
//
// A run snapshots the servers it targets (name, host, port, user, trusted fingerprint) on its target rows,
// so history survives a profile being edited or deleted (`server_profile_id` is a plain id, no foreign key: the history outlives the profile).
// No secret value is stored anywhere in these tables: `secret_refs` maps a parameter to a credential NAME.
// `runbook_run_log_chunks` is a hot buffer: a step's chunks are concatenated into object storage when the
// step ends (`log_storage_key`) and deleted.

model RunbookRun {
  id                String    @id @default(uuid()) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  runbookId         String    @map("runbook_id") @db.Uuid
  version           Int
  status            String    @default("queued")
  trigger           String    @default("manual")
  initiatedBy       String?   @map("initiated_by") @db.Uuid
  retryOfRunId      String?   @map("retry_of_run_id") @db.Uuid
  /// Non-secret parameter values. A secret parameter has no value here: see `secretRefs`.
  params            Json      @default("{}") @db.JsonB
  /// Parameter name to the NAME of an organization credential (purpose `runbook_secret`); never a value.
  secretRefs        Json      @default("{}") @map("secret_refs") @db.JsonB
  /// The target selector the run resolved (a retry names the failed servers by id).
  targetSelector    Json      @map("target_selector") @db.JsonB
  strategy          Json      @db.JsonB
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz
  /// A dry run (#67): connects and checks every step, executes nothing that changes a server.
  dryRun            Boolean   @default(false) @map("dry_run")
  /// The definition had a destructive step when the run was launched (#67): it carried a confirmation.
  destructive       Boolean   @default(false)
  /// Why a run that never started ended (`APPROVAL_REJECTED`, `APPROVAL_EXPIRED`, `CANCELLED`); NULL otherwise.
  errorCode         String?   @map("error_code") @db.VarChar(64)
  /// "Stop AI" (#64): the AI agents of this run end before their next tool call (`AI_STOPPED`).
  aiStopRequestedAt DateTime? @map("ai_stop_requested_at") @db.Timestamptz
  startedAt         DateTime? @map("started_at") @db.Timestamptz
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runbook        Runbook            @relation(fields: [runbookId, orgId], references: [id, orgId], onDelete: Cascade)
  runbookVersion RunbookVersion     @relation(fields: [runbookId, version], references: [runbookId, version], onDelete: Cascade)
  initiator      User?              @relation("RunbookRunInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)
  targets        RunbookRunTarget[]
  steps          RunbookRunStep[]
  chunks         RunbookRunLogChunk[]
  approvals      RunbookApproval[]

  @@unique([id, orgId])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, status])
  @@index([runbookId])
  @@index([initiatedBy])
  @@map("runbook_runs")
}

model RunbookRunTarget {
  id                 String    @id @default(uuid()) @db.Uuid
  orgId              String    @map("org_id") @db.Uuid
  runId              String    @map("run_id") @db.Uuid
  serverProfileId    String?   @map("server_profile_id") @db.Uuid
  /// Position in the deterministic target order; `batchIndex` is the wave it belongs to.
  position           Int
  batchIndex         Int       @default(0) @map("batch_index")
  status             String    @default("pending")
  serverName         String    @map("server_name") @db.VarChar(255)
  hostname           String    @db.VarChar(255)
  port               Int
  username           String    @db.VarChar(255)
  hostKeyFingerprint String?   @map("host_key_fingerprint") @db.VarChar(255)
  /// The step the next segment starts at (a resume after an approval starts after the gate).
  nextStepIndex      Int       @default(0) @map("next_step_index")
  errorCode          String?   @map("error_code") @db.VarChar(64)
  errorMessage       String?   @map("error_message") @db.VarChar(500)
  cancelRequestedAt  DateTime? @map("cancel_requested_at") @db.Timestamptz
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run           RunbookRun        @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  steps         RunbookRunStep[]
  approvals     RunbookApproval[]

  @@unique([id, orgId])
  @@unique([runId, position])
  @@index([runId, status])
  @@index([orgId])
  @@index([serverProfileId])
  @@map("runbook_run_targets")
}

model RunbookRunStep {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  runId         String    @map("run_id") @db.Uuid
  runTargetId   String    @map("run_target_id") @db.Uuid
  stepIndex     Int       @map("step_index")
  /// The definition's step id, kind and name, copied so the matrix needs no definition lookup.
  stepId        String    @map("step_id") @db.VarChar(48)
  kind          String    @db.VarChar(32)
  name          String    @db.VarChar(120)
  status        String    @default("pending")
  exitCode      Int?      @map("exit_code")
  durationMs    Int?      @map("duration_ms")
  /// The last bytes of the (redacted) output, for the matrix; the whole log is in the chunks or in storage.
  outputTail    String?   @map("output_tail") @db.Text
  logBytes      Int       @default(0) @map("log_bytes")
  logTruncated  Boolean   @default(false) @map("log_truncated")
  logStorageKey String?   @map("log_storage_key") @db.VarChar(512)
  errorCode     String?   @map("error_code") @db.VarChar(64)
  /// An `ai_task` step (#64): the conversation so far (redacted input items), kept while the step waits for
  /// a person's approval so the agent can resume; cleared when the step ends. NULL for every other step.
  aiTranscript  Json?     @map("ai_transcript") @db.JsonB
  /// An `ai_task` step: the model's closing summary (redacted, capped).
  aiSummary     String?   @map("ai_summary") @db.Text
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          RunbookRun                @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  target       RunbookRunTarget          @relation(fields: [runTargetId, orgId], references: [id, orgId], onDelete: Cascade)
  chunks       RunbookRunLogChunk[]
  executions   RunbookCommandExecution[]

  @@unique([id, orgId])
  @@unique([runTargetId, stepIndex])
  @@index([runId])
  @@index([orgId])
  @@map("runbook_run_steps")
}

model RunbookRunLogChunk {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  runStepId String   @map("run_step_id") @db.Uuid
  seq       Int
  /// A global arrival order (SSE replay across steps).
  ord       BigInt   @unique @default(autoincrement())
  stream    String   @db.VarChar(8)
  data      String   @db.Text
  bytes     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          RunbookRun     @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  step         RunbookRunStep @relation(fields: [runStepId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([runStepId, seq])
  @@index([runId, ord])
  @@index([orgId])
  @@index([createdAt])
  @@map("runbook_run_log_chunks")
}

model RunbookCommandExecution {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  serverProfileId String?   @map("server_profile_id") @db.Uuid
  runStepId       String?   @map("run_step_id") @db.Uuid
  origin          String    @db.VarChar(16)
  commandSha256   String    @map("command_sha256") @db.Char(64)
  /// At most 2 KiB, redacted (command-safety `redactText` with the run's secret values as literals).
  commandPreview  String    @map("command_preview") @db.Text
  exitCode        Int?      @map("exit_code")
  signal          String?   @db.VarChar(16)
  timedOut        Boolean   @default(false) @map("timed_out")
  bytes           Int       @default(0)
  /// An AI agent command (#64): `succeeded`, `failed`, `timed_out`, `cancelled`, `refused` (the policy said no) or `rejected` (a person declined); nothing ran for the last two. NULL for other origins.
  outcome         String?   @db.VarChar(16)
  /// The person who approved an AI agent command (a plain id, no foreign key: the audit row outlives the user); NULL when no approval was needed.
  approvedBy      String?   @map("approved_by") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz

  organization  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  step          RunbookRunStep? @relation(fields: [runStepId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([orgId, serverProfileId, startedAt(sort: Desc)])
  @@index([runStepId])
  @@index([serverProfileId])
  @@map("runbook_command_executions")
}

model RunbookApproval {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  /// NULL for a run-scope approval (one row for the run).
  runTargetId String?   @map("run_target_id") @db.Uuid
  /// `run` or the target id: with `runId` and `stepIndex` it makes the approval unique (a canary gate is step -1).
  scopeKey    String    @map("scope_key") @db.VarChar(36)
  scope       String    @db.VarChar(8)
  kind        String    @db.VarChar(16)
  stepIndex   Int       @map("step_index")
  stepName    String    @map("step_name") @db.VarChar(120)
  message     String    @default("") @db.VarChar(2000)
  status      String    @default("pending")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz
  comment     String?   @db.VarChar(1000)
  /// An AI approval (#64): `ai_command` carries `{ command, commandSha256, reason }` (the command redacted), `ai_plan`
  /// `{ summary, commands: [{ command, reason, refused }] }`. NULL for every other kind.
  payload     Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run          RunbookRun        @relation(fields: [runId, orgId], references: [id, orgId], onDelete: Cascade)
  target       RunbookRunTarget? @relation(fields: [runTargetId, orgId], references: [id, orgId], onDelete: Cascade)
  decider      User?             @relation("RunbookApprovalDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@unique([runId, stepIndex, scopeKey])
  @@index([orgId, status, expiresAt])
  @@index([runId])
  @@index([decidedBy])
  @@map("runbook_approvals")
}

extend model User {
  initiatedRunbookRuns    RunbookRun[]      @relation("RunbookRunInitiator")
  decidedRunbookApprovals RunbookApproval[] @relation("RunbookApprovalDecider")
}

extend model Organization {
  runbookRuns              RunbookRun[]
  runbookRunTargets        RunbookRunTarget[]
  runbookRunSteps          RunbookRunStep[]
  runbookRunLogChunks      RunbookRunLogChunk[]
  runbookCommandExecutions RunbookCommandExecution[]
  runbookApprovals         RunbookApproval[]
}

extend model Group {
  ownedRunbooks Runbook[] @relation("RunbookOwnerGroup")
}
