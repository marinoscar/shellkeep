// ShellKeep domain: terminal snippets (#172, epic #171).
//
// A snippet is a saved piece of text (a command or a few lines) the user inserts into the terminal from
// the key panel's Snippets tab. It is inserted, never run: the user presses Enter.
//
// Storage decision (docs/specs/terminal.md, "Snippets"): a table of its own, not the `shortcuts`
// settings namespace. Snippets are user content with ordering, search and potentially many rows; a settings
// document has a size cap, is replaced whole on every write (two devices editing different snippets would
// overwrite each other) and cannot be searched or ordered in the database.
//
// Ownership: user-owned (`user_id`, cascade on user delete), `orgReference: 'orgId'` (a reference to the
//   organization the snippet was created in, not an isolation key; it is the same shape as `terminal_sessions`
//   and `server_profiles`). A snippet is private to its owner and never shared, so it is NOT an org table and
//   has no row-level security: every query names the owner, and another user's id is a 404.
// Purge: Cascade on user delete (the platform's user-data purge deletes the rows first so they are counted).
// Limits (the migration repeats them as CHECK constraints): title 1..80 characters, body 1..4096 bytes,
//   at most 8 tags of 1..24 characters, at most 200 snippets per user (enforced by the service).
// Never logged, never sent to a model, never in a span. The body may hold a credential the user pasted;
//   the service flags that on save (`warning: 'looks-like-secret'`) and does not block it.

model Snippet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  title     String   @db.VarChar(80)
  body      String
  tags      String[] @default([])
  /// 0-based, dense per user (the service renumbers on delete and reorder).
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@index([userId, position])
  @@index([orgId, userId])
  @@map("snippets")
}

extend model User {
  snippets Snippet[]
}

extend model Organization {
  snippets Snippet[]
}
