// ShellKeep domain: SSH server profiles.
//
// Ownership: user-owned (`user_id`), `orgReference: 'orgId'`.
// Purge: Cascade on user delete (a deleted user takes their profiles with them).
// No RLS: this table carries org_id but is not under row-level security; see
//   docs/platform-adoption/local-exceptions.md (standing constraints).
// SSH credential columns (`encrypted_*`) are LEGACY since #48: they hold AES-256-GCM ciphertext under the
//   legacy key, are never read, and stay until a later migration drops them (#84). The secrets live in
//   the platform credential store (purpose `ssh`, names `profile.<profileId>.<field>`).

enum AuthMethod {
  password
  key
  agent
}

model ServerProfile {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @map("user_id") @db.Uuid
  orgId               String     @map("org_id") @db.Uuid
  name                String
  hostname            String
  port                Int        @default(22)
  username            String
  authMethod          AuthMethod @map("auth_method")
  encryptedPassword   String?    @map("encrypted_password")
  encryptedPrivateKey String?    @map("encrypted_private_key")
  encryptedPassphrase String?    @map("encrypted_passphrase")
  fingerprint         String?
  tags                String[]
  color               String     @default("default")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  sessions     TerminalSession[]

  @@index([userId])
  @@index([orgId, userId])
  @@map("server_profiles")
}

extend model User {
  serverProfiles ServerProfile[]
}

extend model Organization {
  serverProfiles ServerProfile[]
}
