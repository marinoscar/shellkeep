// ShellKeep domain: SSH server profiles.
//
// Ownership: user-owned (`user_id`), `orgReference: 'orgId'`.
// Purge: Cascade on user delete (a deleted user takes their profiles with them).
// No RLS: this table carries org_id but is not under row-level security; see
//   docs/platform-adoption/local-exceptions.md (standing constraints).
// Sharing (#71): `ownerGroupId` is the OPTIONAL owning group (a group-owned profile). `user_id` stays the
//   user who created the profile and holds its SSH credentials in the credential store; it is NOT NULL.
//   The pair (org_id, owner_group_id) is a COMPOSITE foreign key to groups (id, org_id): a foreign-key
//   check bypasses row-level security, so a plain key could point at another organization's group. NULL
//   `owner_group_id` skips the check (MATCH SIMPLE). ON DELETE NO ACTION (checked at the end of the
//   statement, so deleting an organization still cascades): SET NULL would null `org_id` too, so the app
//   refuses to delete a group that owns a profile (409 GROUP_OWNS_RESOURCES) instead.
// SSH credential columns (`encrypted_*`) are LEGACY since #48: they hold AES-256-GCM ciphertext under the
//   legacy key, are never read, and stay until a later migration drops them (#84). The secrets live in
//   the platform credential store (purpose `ssh`, names `profile.<profileId>.<field>`).

enum AuthMethod {
  password
  key
  agent
}

model ServerProfile {
  id                  String     @id @default(uuid()) @db.Uuid
  userId              String     @map("user_id") @db.Uuid
  orgId               String     @map("org_id") @db.Uuid
  name                String
  hostname            String
  port                Int        @default(22)
  username            String
  authMethod          AuthMethod @map("auth_method")
  encryptedPassword   String?    @map("encrypted_password")
  encryptedPrivateKey String?    @map("encrypted_private_key")
  encryptedPassphrase String?    @map("encrypted_passphrase")
  fingerprint         String?
  hostKeyAlgorithm    String?    @map("host_key_algorithm")
  hostKeyTrustedAt    DateTime?  @map("host_key_trusted_at") @db.Timestamptz
  hostKeyTrustedBy    String?    @map("host_key_trusted_by") @db.Uuid
  facts               Json?      @map("facts")
  factsProbedAt       DateTime?  @map("facts_probed_at") @db.Timestamptz
  // #56: when false, no terminal output of this server reaches an AI feature (the hard control).
  aiOutputSharing     Boolean    @default(true) @map("ai_output_sharing")
  tags                String[]
  color               String     @default("default")
  ownerGroupId        String?    @map("owner_group_id") @db.Uuid
  // #79: the outcome of the last connection test (`POST /server-profiles/:id/test`), the Servers page's
  //   health column and the Home dashboard's reachability. NULL `last_test_at`: never tested ("unknown").
  //   `last_test_code` is the host-key refusal of that test (HOST_KEY_UNKNOWN / HOST_KEY_MISMATCH), else NULL.
  lastTestAt          DateTime?  @map("last_test_at") @db.Timestamptz
  lastTestOk          Boolean?   @map("last_test_ok")
  lastTestCode        String?    @map("last_test_code")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  ownerGroup   Group?            @relation("ServerProfileOwnerGroup", fields: [ownerGroupId, orgId], references: [id, orgId], onDelete: NoAction)
  sessions     TerminalSession[]
  fileArchives FileArchive[]

  @@index([userId])
  @@index([orgId, userId])
  @@index([orgId, ownerGroupId])
  @@map("server_profiles")
}

extend model User {
  serverProfiles ServerProfile[]
}

extend model Organization {
  serverProfiles ServerProfile[]
}

extend model Group {
  ownedServerProfiles ServerProfile[] @relation("ServerProfileOwnerGroup")
}
