# =============================================================================
# API Dockerfile - Multi-stage build
# =============================================================================

# -----------------------------------------------------------------------------
# Base stage
# -----------------------------------------------------------------------------
FROM node:24-alpine AS base
WORKDIR /app
# Install OpenSSL for Prisma compatibility.
#
# `postgresql17-client` is pg_dump, pg_restore and psql, for the platform database backup
# and restore (#52). It is in the BASE stage so `development` and `production` both ship
# it: a backup that only works in one of them is exercised first on the night it is needed.
#
# THE MAJOR IS PINNED EXPLICITLY. The floating `postgresql-client` meta-package tracks
# whatever major the Alpine release under `node:24-alpine` ships, so a base-image refresh
# could move the client without a line of this repository changing, and `pg_dump` REFUSES
# to dump a server newer than itself. 17 is the platform's floor (MIN_PG_CLIENT_MAJOR in
# `@marinoscar/platform-api/db-backup`); a 17 client dumps and restores a 14 to 17 server,
# and CI and the rehearsals run PostgreSQL 16. `test/pg-client-version.spec.ts` holds this
# number equal to the constant. To bump the pair: docs/runbooks/postgres-client-version.md.
RUN apk add --no-cache openssl openssl-dev postgresql17-client
RUN corepack enable

# -----------------------------------------------------------------------------
# Dependencies stage
# -----------------------------------------------------------------------------
# BUILD CONTEXT IS THE REPOSITORY ROOT (infra/compose/base.compose.yml:
# `context: ../..`, `dockerfile: apps/api/Dockerfile`), so the root
# package-lock.json is reachable and the API installs exactly what the lock
# resolves. The platform's compose files (generated by
# `npm run platform:infra:sync`) also assume the workspace layout below: the
# development stage keeps the sources at /app/apps/api and mounts
# ../../apps/api/src there.
FROM base AS deps
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
# Every workspace manifest is required: `npm ci` validates the whole workspace set against
# the lockfile, even when installing one workspace (apps/cli is the shellkeep CLI).
COPY apps/cli/package.json ./apps/cli/
COPY packages ./packages/
COPY apps/api/prisma ./apps/api/prisma/
COPY apps/api/prisma.config.ts ./apps/api/
COPY apps/api/scripts ./apps/api/scripts/
# `re2` (runbook pattern validation) is native: --ignore-scripts skips its install step, so rebuild it
# explicitly (prebuilt binary download, node-gyp fallback).
# Prisma generate needs no connection: a dummy DATABASE_URL satisfies the config.
RUN npm ci --workspace=api --include-workspace-root --ignore-scripts && \
    npm rebuild re2 && \
    cd apps/api && \
    DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npm run prisma:generate

# -----------------------------------------------------------------------------
# Development stage
# -----------------------------------------------------------------------------
FROM base AS development
COPY --from=deps /app ./
COPY tsconfig.base.json ./
COPY scripts ./scripts
COPY apps/api ./apps/api
WORKDIR /app/apps/api
EXPOSE 3000
CMD ["npm", "run", "start:dev"]

# -----------------------------------------------------------------------------
# Build stage
# -----------------------------------------------------------------------------
FROM base AS build
COPY --from=deps /app ./
COPY tsconfig.base.json ./
COPY apps/api ./apps/api
WORKDIR /app/apps/api
RUN npm run build

# -----------------------------------------------------------------------------
# Production stage
# -----------------------------------------------------------------------------
FROM base AS production
COPY --from=deps /app ./
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY apps/api/prisma ./apps/api/prisma/
COPY apps/api/prisma.config.ts ./apps/api/
COPY apps/api/scripts ./apps/api/scripts/
COPY scripts ./scripts
WORKDIR /app/apps/api
EXPOSE 3000
CMD ["npm", "run", "start:prod"]
