# =============================================================================
# Answers for the deploy-e2e workflow's unattended install (issue #150)
# =============================================================================
# Handed to `deploy install --non-interactive --answers-file`. The workflow
# appends JWT_SECRET, COOKIE_SECRET and SECRETS_ENCRYPTION_KEY to a private copy
# at run time (an unattended install cannot generate them).
#
# NOTHING HERE IS A CREDENTIAL: every value is a placeholder on a reserved name
# (RFC 2606 `.invalid`) or a throwaway database password that exists only inside
# one runner's `services:` container. The `e2e-placeholder` sentinel must appear
# ONLY on keys the CLI treats as secret; the journal assertion greps for it.
# =============================================================================

# The workflow's `services: postgres` container, published on the runner and
# reached from the app containers at the docker0 gateway. POSTGRES_PASSWORD here
# and the service's own are one value in two places and MUST agree.
POSTGRES_HOST=172.17.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=e2e-placeholder-postgres-password
POSTGRES_DB=appdb
POSTGRES_SSL=false

# Never used: no browser reaches this deployment and no OAuth round trip runs.
GOOGLE_CLIENT_ID=e2e-oauth-client-id.apps.googleusercontent.invalid
GOOGLE_CLIENT_SECRET=e2e-placeholder-google-oauth-client-secret

INITIAL_ADMIN_EMAIL=e2e-admin@e2e.invalid

# Keeps the API from depending on a collector this job does not run.
OTEL_ENABLED=false

# The template's 512M is too small for `prisma:seed`; a hosted runner has room.
API_MEM_LIMIT=2g
WEB_MEM_LIMIT=256m
