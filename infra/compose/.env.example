# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
# =============================================================================

# Docker Compose project name (REQUIRED - avoids conflicts with other projects)
COMPOSE_PROJECT_NAME=shellkeep

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:8323

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Individual connection parameters (DATABASE_URL is constructed from these)
# POSTGRES_USER is the application role (shellkeep_app: NOSUPERUSER NOBYPASSRLS,
# owner of the tables), created by apps/api/prisma/sql/create-app-role.sql; the
# default below is the local development superuser only. Never run production
# as a superuser: row-level security is inert for one. docs/runbooks/application-role.md
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# JWT / Session
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECRET=your-cookie-secret-key-min-32-characters-long

# -----------------------------------------------------------------------------
# Encryption (stored credentials: SSH secrets of server profiles)
# -----------------------------------------------------------------------------
# Master key of the platform credential store (AES-256-GCM, a sub-key per user and
# purpose). Base64 of 32 bytes. Required once any credential is stored; the API
# refuses to start with a missing or malformed key when credentials exist.
# Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Legacy key of the SSH secrets stored before the credential store (#48). Read only
# by `npm run ssh:migrate-secrets` (docs/runbooks/ssh-secret-reencryption.md); keep
# the value you have until the legacy columns are dropped, then remove the variable.
# Leave it empty on a new deployment.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# OAuth - Google (Required)
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8323/api/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth - Microsoft (Optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:8323/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Initial Admin Bootstrap
# -----------------------------------------------------------------------------
# First user to log in with this email will be assigned Admin role
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Test Authentication (Development/Test Only)
# -----------------------------------------------------------------------------
# Test auth is automatically enabled when NODE_ENV !== 'production'
# This provides /api/auth/test/login endpoint and /testing/login page
# for Playwright E2E testing without requiring real OAuth credentials.
#
# Set to 'false' to explicitly disable test auth in development:
# TEST_AUTH_ENABLED=false
#
# WARNING: Setting TEST_AUTH_ENABLED=true in production will cause the app
# to fail at startup as a safety measure.

# -----------------------------------------------------------------------------
# Device Authorization Flow (RFC 8628)
# -----------------------------------------------------------------------------
# Configuration for device authorization (CLI, Swagger UI, mobile apps)
DEVICE_CODE_EXPIRY_MINUTES=15
DEVICE_CODE_POLL_INTERVAL=5

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# PLATFORM-ADOPTION-SHIM(#73): copied from @marinoscar/platform-infra 0.1.0-next.39
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=shellkeep-api
LOG_LEVEL=info
# OTEL diagnostic logging (development only) is enabled by setting OTEL_DEBUG to true.

# -----------------------------------------------------------------------------
# GreptimeDB telemetry store (when using telemetry.compose.yml)
# -----------------------------------------------------------------------------
# The collector writes traces, metrics and logs into GreptimeDB; the API reads
# them back for the telemetry explorer and the AI assistant. When GREPTIME_HOST
# is unreachable the API reports telemetry as unavailable instead of failing.
#
# The reader and admin values below are the DEPLOYMENT DEFAULT only: an
# administrator can instead save a GreptimeDB connection (host, port,
# database, reader/admin logins) at /admin/settings/telemetry, and a stored
# connection is then used wholly in place of these two accounts, with no
# restart. The writer login and the HTTP port are never configurable there —
# only the OTel collector and the GreptimeDB container use them.
GREPTIME_HOST=greptimedb
# HTTP API and SQL dashboard port inside the compose network.
GREPTIME_HTTP_PORT=4000
# PostgreSQL wire-protocol port inside the compose network (API reads, BI tools).
GREPTIME_PG_PORT=4003
# Host port for GreptimeDB's PostgreSQL wire protocol on a VPS deployment
# (vps.telemetry.compose.yml). It is bound to 127.0.0.1 only: analysts reach it
# through an SSH tunnel. Give each deployment on a shared host its own value.
GREPTIME_BIND_PG_PORT=14003
GREPTIME_DB=public
# Three accounts, three privileges. The writer is used only by the collector to
# ingest, and is never configurable from the admin UI. The reader is read-only
# and is used by the explorer, the AI assistant and BI tools. The admin runs
# DDL and is used only to set retention (TTL); both reader and admin are only
# the deployment default (see above). These passwords are development
# placeholders: CHANGE THEM before exposing the telemetry stack anywhere
# non-local. telemetry.compose.yml refuses to start GreptimeDB when any of
# them is empty.
GREPTIME_WRITER_USER=writer
GREPTIME_WRITER_PASSWORD=change-me-writer
GREPTIME_READER_USER=reader
GREPTIME_READER_PASSWORD=change-me-reader
GREPTIME_ADMIN_USER=admin
GREPTIME_ADMIN_PASSWORD=change-me-admin

# -----------------------------------------------------------------------------
# Storage upload limits
# -----------------------------------------------------------------------------
# WHERE objects are stored (provider, bucket, region, endpoint, keys) is runtime
# configuration at /admin/settings/storage, never an environment variable. An
# upgrade from a build that read S3_* and AWS_* runs `npm run storage:import-env`
# once (docs/runbooks/storage-configuration.md). These three only bound what the
# deployment accepts or issues.
MAX_FILE_SIZE=10737418240  # 10GB in bytes
ALLOWED_MIME_TYPES=image/*,application/pdf,video/*
SIGNED_URL_EXPIRY=3600  # Signed URL expiration in seconds (1 hour)
