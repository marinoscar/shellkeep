# -----------------------------------------------------------------------------
# App variables
# -----------------------------------------------------------------------------
# Variables of this application only, appended to infra/compose/.env.example
# after the platform's by `platform-infra sync` (this file is APP-OWNED: it is
# created once and never overwritten; .env.example itself is generated). Add a
# variable here as KEY=value with its explanation on the lines above it, then
# run the sync. Never add a commented-out KEY=value line: the deploy wizard
# reads every such line as a declared variable.

# -----------------------------------------------------------------------------
# Docker Compose project
# -----------------------------------------------------------------------------
# Docker Compose project name. REQUIRED when other projects share the Docker
# host: it prefixes container, network and volume names, so two checkouts or
# two apps never collide (docs/docker-compose-project-name-fix.md).
COMPOSE_PROJECT_NAME=shellkeep

# -----------------------------------------------------------------------------
# Published port
# -----------------------------------------------------------------------------
# Host port nginx publishes in the development and devdb stacks. ShellKeep
# serves on 8323 (the shared VPS reverse proxy and the docs use it) instead of
# the platform default 3535. On a VPS the vps overlay publishes
# 127.0.0.1:APP_BIND_PORT instead, so set APP_BIND_PORT=8323 there. Keep
# APP_URL (and GOOGLE_CALLBACK_URL) on the same port, for example
# http://localhost:8323 in development.
NGINX_PORT=8323

# -----------------------------------------------------------------------------
# Legacy SSH secret key
# -----------------------------------------------------------------------------
# Key of the SSH secrets stored before the platform credential store (#48).
# Read only by `npm run ssh:migrate-secrets`
# (docs/runbooks/ssh-secret-reencryption.md); keep the value you have until the
# legacy columns are dropped, then remove the variable. Leave it empty on a new
# deployment. The master key of the credential store is the platform's
# SECRETS_ENCRYPTION_KEY, not this one.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# SSH egress check
# -----------------------------------------------------------------------------
# Optional. A host (or host:port, 22 by default) the `shellkeep deploy doctor`
# check `ssh-egress` opens a TCP connection to from the api container, to prove
# that outbound SSH works from inside the stack. Leave empty to skip the check.
SSH_EGRESS_TEST_HOST=
