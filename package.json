{
  "name": "shellkeep",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "check:classification": "node scripts/platform-adoption/check-classification.mjs",
    "typecheck": "npm run typecheck --workspace=api && npm run typecheck --workspace=web"
  },
  "overrides": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/platform-ws": "^11.1.12",
    "@nestjs/websockets": "^11.1.12"
  }
}
