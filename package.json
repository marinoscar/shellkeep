{
  "name": "shellkeep",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "npm -w apps/api",
    "web": "npm -w apps/web",
    "cli": "npm -w apps/cli",
    "api:dev": "npm -w apps/api run start:dev",
    "web:dev": "npm -w apps/web run dev",
    "api:test": "npm -w apps/api test",
    "web:test": "npm -w apps/web test",
    "check:classification": "node scripts/platform-adoption/check-classification.mjs",
    "openapi:dump": "npm run openapi:dump --workspace=api -- ../../openapi.json",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity=error",
    "typecheck": "npm run typecheck --workspace=api && npm run typecheck --workspace=web",
    "lint": "eslint \"apps/{api,web}/src/**/*.{ts,tsx}\"",
    "check:platform-imports": "eslint --max-warnings=0 --config eslint.platform-imports.config.mjs \"apps/{api,web}/src/**/*.{ts,tsx}\"",
    "check:platform-pin": "node scripts/check-platform-pin.mjs",
    "check:single-instance": "node scripts/check-single-instance.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "platform:infra:sync": "platform-infra sync",
    "test:infra": "node --test tests/infra/infra-conformance.test.mts"
  },
  "overrides": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/platform-ws": "^11.1.12",
    "@nestjs/websockets": "^11.1.12",
    "@marinoscar/platform-contract": "$@marinoscar/platform-contract"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marinoscar/platform-contract": "0.1.0-next.39",
    "@marinoscar/platform-infra": "0.1.0-next.39",
    "@stoplight/spectral-cli": "^6.17.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.74.0"
  }
}
